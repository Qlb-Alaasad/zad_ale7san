# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: canonical public URL for Google OAuth redirect (production Netlify domain).
# If unset, the app uses window.location.origin at runtime.
# VITE_SITE_URL=https://your-app.netlify.app

# Add these redirect URLs in Supabase Dashboard → Authentication → URL Configuration:
# - http://localhost:5173/auth/callback
# - https://your-app.netlify.app/auth/callback
